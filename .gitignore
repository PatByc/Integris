yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude local state
.claude/tmp/
.claude/cache/

# Testing
playwright-report/
test-results/

# Misc
*.pem
*.key
*.sqlite
```