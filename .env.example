# App
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Supabase (backend — keep secret, never expose to browser)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database (direct Postgres connection for backend + Alembic)
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase Storage
SUPABASE_STORAGE_BUCKET=invoices

# Redis
REDIS_URL=redis://localhost:6379/0

# Google Cloud Vision OCR
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_APPLICATION_CREDENTIALS=path_to_local_service_account_json

# AI Provider
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4.1-mini

# KSeF Sandbox
KSEF_ENV=sandbox
KSEF_API_URL=your_ksef_sandbox_api_url
KSEF_CLIENT_ID=your_ksef_client_id
KSEF_CLIENT_SECRET=your_ksef_client_secret

# Security
JWT_SECRET=replace_with_local_dev_secret

# ─── Frontend-only variables (copy to frontend/.env.local) ───────────────────
# These must be prefixed NEXT_PUBLIC_ to be accessible in the browser.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_API_URL=http://localhost:8000
